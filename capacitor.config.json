{
  "appId": "ai.myalfred.mybrief",
  "appName": "MyBrief",
  "webDir": "www",
  "server": {
    "errorPath": "error.html",
    "cleartext": false
  },
  "ios": {
    "appendUserAgent": "MyBrief-App/ios",
    "contentInset": "never"
  },
  "android": {
    "appendUserAgent": "MyBrief-App/android",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 800,
      "backgroundColor": "#FFFEFC"
    }
  }
}
