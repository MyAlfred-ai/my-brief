# MyBrief — configuration d'installation.
# Copier en `.env` À CÔTÉ du docker-compose.yml, puis renseigner les valeurs
# obligatoires ci-dessous : DOMAIN, MONGO_PASS, et ACME_EMAIL pour la stack
# complète. Tout le reste a un défaut utilisable.
#
#   cp env.example .env && $EDITOR .env

# ── OBLIGATOIRE ─────────────────────────────────────────────────────────────

# Nom de domaine public. Il doit DÉJÀ pointer sur l'IP de ce serveur avant le
# premier démarrage : Let's Encrypt le vérifie en HTTP pour délivrer le
# certificat.
DOMAIN=mybrief.example.com

# Adresse à laquelle Let's Encrypt écrit en cas d'expiration de certificat.
# (Inutile avec docker-compose.proxy.yml : le proxy existant gère le TLS.)
ACME_EMAIL=admin@example.com

# Mot de passe root de MongoDB. À GÉNÉRER, jamais à inventer :
#   openssl rand -hex 24
# Hexadécimal et PAS base64 : il est interpolé tel quel dans l'URL
# mongodb://root:<mot de passe>@… — un « / » de base64 la rend invalide.
# Le changer après le premier démarrage rend la base inaccessible : il est
# inscrit dans le volume à l'initialisation.
MONGO_PASS=

# ── Clé OpenAI — amorçage, peut rester VIDE ─────────────────────────────────

# Clé OpenAI (résumé, titre, actions, transcription Whisper, Realtime). Elle
# ne vit QUE sur le serveur — le navigateur ne reçoit que des jetons éphémères
# via /api/tempkey. Sans elle l'application démarre et enregistre ; seules l'IA
# et la transcription répondent 503 en disant où la renseigner.
#
# Peut rester vide : la clé se règle aussi dans Administration → IA, où elle est
# vérifiée auprès d'OpenAI avant d'être enregistrée. Une clé saisie là-bas PRIME
# sur celle-ci — c'est ce qui permet de réparer une clé expirée sans accès SSH.
OPENAI_API_KEY=

# ── Modèles OpenAI par usage (facultatif) ────────────────────────────────────
# Vides = défauts du code (services/api/lib/config.js).
# Le modèle du RÉSUMÉ se choisit dans Administration → IA (gpt-5.6 Sol,
# gpt-5.4 par défaut, gpt-5.4-mini). Il tournait sur gpt-4o-mini jusqu'au
# 2026-09-01 : c'était la cause numéro un de l'écart de qualité avec
# l'application ChatGPT à prompt identique. Cette variable reste la porte de
# sortie sans écran, et accepte un modèle hors de la liste proposée :
#   OPENAI_MODEL_SUMMARY=gpt-5.6-terra   # palier 5.6 intermédiaire, non listé
# OPENAI_MODEL_SUMMARY=
# Titre, relecture et détection d'actions : gpt-6-luna par défaut. gpt-5-mini
# est retiré par OpenAI le 2026-12-11 ; gpt-4o-mini, gpt-4o, gpt-4.1 et
# gpt-4.1-mini le 2027-01-14 : ne plus les imposer.
# OPENAI_MODEL_TITLE=
# OPENAI_MODEL_ACTIONS=
# OPENAI_MODEL_REFINE=
# OPENAI_MODEL_INFOGRAPHIC=
# OPENAI_MODEL_INFOGRAPHIC_IMAGE=
# OPENAI_MODEL_TRANSCRIPTION=
# Plafond de temps du seul appel de résumé, en ms (défaut 300000). Un modèle
# raisonnant sur une réunion d'une heure dépasse les 120 s des autres appels.
# OPENAI_SUMMARY_TIMEOUT_MS=

# ── Premier administrateur ──────────────────────────────────────────────────
# Le compte d'amorçage n'est créé que si la base ne contient AUCUN compte, et
# son mot de passe doit être changé à la première connexion. Sur une base déjà
# peuplée, il n'est pas créé — utiliser ADMIN_EMAILS.
# Son mot de passe se GÉNÈRE (install.sh le tire au hasard) :
#   openssl rand -hex 9
# Obligatoires sur une base vierge : l'API refuse de démarrer sans email ou
# avec un mot de passe de moins de 12 caractères.
ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=

# Emails promus administrateurs à CHAQUE démarrage (séparés par des virgules).
# Le moyen de désigner un administrateur sans passer par l'interface, par
# exemple après avoir perdu l'accès au compte d'amorçage.
ADMIN_EMAILS=

# Domaines dont TOUT compte est administrateur, réappliqué à chaque démarrage.
# Réservé aux déploiements internes, où l'on maîtrise la création des comptes du
# domaine. Pour une installation client, laisser VIDE et désigner les
# administrateurs un par un avec ADMIN_EMAILS ci-dessus.
ADMIN_EMAIL_DOMAINS=

# ── Version déployée ────────────────────────────────────────────────────────
# `main` suit la branche principale. Pour une production, préférer une version
# figée (ex. `v1.2.0`) : la mise à jour devient un geste explicite.
# Version publiée en service : écrite par install.sh puis update.sh.
MYBRIEF_VERSION=1.3.0
# Nom du projet compose (préfixe des conteneurs et des volumes) : ne plus le
# changer après l'installation, les volumes de données en dépendent.
COMPOSE_PROJECT_NAME=mybrief

# ── Traefik existant — UNIQUEMENT pour docker-compose.proxy.yml ────────────
# Nom du réseau docker que le Traefik en place utilise pour joindre les
# conteneurs. Se lit avec : docker network ls
#TRAEFIK_NETWORK=webproxy
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=myresolver

# ── Mot de passe oublié (optionnel) ─────────────────────────────────────────
# SMTP_HOST vide = fonctionnalité désactivée proprement : le lien « mot de
# passe oublié » disparaît de l'écran de connexion et l'endpoint répond 501.
# Les administrateurs peuvent toujours réinitialiser un mot de passe depuis
# l'interface de gestion des utilisateurs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MyBrief <no-reply@example.com>

# --- Chiffrement des comptes reliés (Gmail / Outlook) ---
# Chiffre AU REPOS les refresh tokens de `userConnections`, et la clé d'API
# myBrain (Administration → MyBrain). install.sh la génère ; à la main, une
# fois (hexadécimal ou base64, les deux sont acceptés) :
#   openssl rand -hex 32
#
# Ce qu'elle protège : une COPIE de la base séparée de son environnement —
# mongodump, archive de backup.sh, volume récupéré. Un refresh token y vaut le
# pouvoir d'écrire depuis la boîte d'une personne, indéfiniment et à son insu.
# La clé vit ici et JAMAIS en base : la ranger à côté du chiffré ne protégerait
# de rien.
#
# VIDE => stockage en clair, comportement historique inchangé. Les connexions
# déjà en clair continuent de fonctionner et se re-scellent d'elles-mêmes à leur
# prochaine reconnexion : personne n'a à se reconnecter.
# ⚠️ La CHANGER rend illisibles les connexions déjà scellées — les utilisateurs
# concernés devront relier leur compte — et la clé myBrain, à ressaisir.
CONNECTIONS_ENC_KEY=
PASSWORD_RESET_TTL_MIN=30

# ── App mobile (optionnel) ──────────────────────────────────────────────────
# Requis seulement avec `docker compose --profile mobile up -d`.
# Générer une fois :  openssl rand -hex 32
# Le changer déconnecte toutes les applications mobiles installées.
#MOBILE_AUTH_JWT_SECRET=

# ── Divers ──────────────────────────────────────────────────────────────────
# Durée de vie d'une session, glissante (réarmée à chaque usage).
SESSION_TTL_DAYS=7
LOG_LEVEL=info
#TRAEFIK_LOG_LEVEL=INFO
