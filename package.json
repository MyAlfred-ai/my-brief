{
  "name": "mybrief-svelte",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --config vite.config.local.js",
    "dev:local:password": "DEV_FAKE_OIDC=0 vite --config vite.config.local.js",
    "dev:backend": "docker compose --env-file docker/.env -f docker/docker-compose.dev.yml up -d",
    "dev:backend:stop": "docker compose --env-file docker/.env -f docker/docker-compose.dev.yml down",
    "dev:backend:logs": "docker compose --env-file docker/.env -f docker/docker-compose.dev.yml logs -f api",
    "build:extension": "node scripts/build-extension.mjs",
    "prebuild": "npm run build:extension",
    "predev": "npm run build:extension",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "svelte-check",
    "prepare": "git config core.hooksPath .githooks || true",
    "docs:generate": "node scripts/generate-docs.mjs",
    "whats-new": "node scripts/generate-whats-new.mjs",
    "whats-new:check": "node scripts/generate-whats-new.mjs --check",
    "mobile:instance": "node scripts/mobile-instance.mjs",
    "mobile:sync": "cap sync android && cap copy ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@iconify-json/solar": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^17.9.0",
    "jsdom": "^27.0.1",
    "openai": "^4.77.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.6",
    "typescript": "^7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "@tiptap/core": "^3.23.5",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "html2canvas-pro": "^2.4.0",
    "jspdf": "^2.5.2"
  }
}
